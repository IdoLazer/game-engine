#.@...111........#G####H######
#########LLL.....#G####H######
#########.........g....h.....#
#########.........g....h.....#
#########lll.222..g....h.....#
##############################
##############################

[SpawnPoint]
Name = start
Anchor = @

[PressurePlate]
Anchor = 1
Switches = lift
Color = 0.25, 0.75, 0.7, 1

[MovablePlatform]
Name = lift
Anchor = l
EndAnchor = L
MoveSpeed = 1.5
Color = 0.25, 0.75, 0.7, 1

[PressurePlate]
Anchor = 2
Switches = gate
Color = 0.9, 0.5, 0.2, 1

[MovablePlatform]
Name = gate
Anchor = g
EndAnchor = G
MoveSpeed = 1.5
Color = 0.9, 0.5, 0.2, 1

[MovablePlatform]
Name = gate
Anchor = h
EndAnchor = H
MoveSpeed = 1.5
Color = 0.9, 0.5, 0.2, 1
