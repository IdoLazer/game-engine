[SpawnPoint]
Name = start
Anchor = @

[Lever]
Anchor = 1
Switches = lift
Color = 0.9, 0.5, 0.2, 1

[MovablePlatform]
Name = lift
Anchor = l
EndAnchor = L
MoveSpeed = 2
Color = 0.9, 0.5, 0.2, 1

[PressurePlate]
Anchor = 2
Switches = ferry
Color = 0.25, 0.75, 0.7, 1

[MovablePlatform]
Name = ferry
Anchor = f
EndAnchor = F
MoveSpeed = 2
Color = 0.25, 0.75, 0.7, 1

[BreakableWall]
Anchor = w
Color = 0.65, 0.5, 0.35, 1
