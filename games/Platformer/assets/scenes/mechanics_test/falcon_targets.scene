// Falcon targets: whatever the falcon is sent to decides what happens there.
// A target glows while you aim at it, and while the falcon is on its way to it or holds it.
//   1 is a lever on the wall: send the falcon to it and it holds on, and the lift l rises to L for as long as it does.
//     Step onto the lift and ride it up to the mesa, then retrieve the falcon: the lift goes back down.
//   2 is a plate: stand on it and the ferry f sails across the room to F.
//     Send the falcon to the ferry while it sails and it travels with it. Step off the plate and the ferry carries it back.
//   w is a breakable wall closing the corridor: send the falcon to it and it breaks, then the falcon flies straight back.
// A lift that comes down on you crushes you: press R to try again.

[Tile]
WorldPosition = 0, 0
WorldSize = 30, 20
Color = 0.5, 0.7, 1, 1

[PlatformerWorld]
StaticTileColor = 0.3, 0.3, 0.3, 1
DeathTileColor = 0.7, 0.1, 0.1, 1
TileGrid = |
